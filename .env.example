# Copie para .env (NUNCA commite o .env). O app não lê o arquivo sozinho:
# carregue com EnvironmentFile= no systemd ou com "export".
SAMBA_AUDIT_DB=/opt/samba_audit/samba_audit.db
SAMBA_AUDIT_LOG=/var/log/syslog
SAMBA_AUDIT_BASE_DIR=/dados
# Use 127.0.0.1 só se o reverse proxy estiver na mesma máquina do painel
SAMBA_AUDIT_HOST=0.0.0.0
SAMBA_AUDIT_PORT=3000
